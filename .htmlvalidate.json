{
  "extends": ["html-validate:recommended"],
  "rules": {
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "attribute-boolean-style": "off",
    "require-sri": "off",
    "no-inline-style": [
      "error",
      {
        "include": ["display", "position", "width", "height"]
      }
    ],
    "no-redundant-role": "off",
    "doctype-style": "off"
  }
}
