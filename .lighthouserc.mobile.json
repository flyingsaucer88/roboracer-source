{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/roboracer-site",
      "url": [
        "http://localhost/index.html",
        "http://localhost/autonomous-racing-robotics-kit.html",
        "http://localhost/specifications.html",
        "http://localhost/getting-started.html",
        "http://localhost/use-cases.html",
        "http://localhost/resource.html",
        "http://localhost/our-clients.html",
        "http://localhost/contact.html",
        "http://localhost/404.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/404\\.html$",
          "preset": "lighthouse:no-pwa",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 350
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 200000
              }
            ],
            "resource-summary:image:size": [
              "error",
              {
                "maxNumericValue": 900000
              }
            ],
            "resource-summary:stylesheet:size": [
              "error",
              {
                "maxNumericValue": 60000
              }
            ],
            "uses-text-compression": "off",
            "uses-long-cache-ttl": "off",
            "server-response-time": "off",
            "csp-xss": "off",
            "third-party-cookies": "warn",
            "unused-javascript": "warn",
            "legacy-javascript": "warn",
            "lcp-lazy-loaded": "off",
            "prioritize-lcp-image": "off",
            "non-composited-animations": "off",
            "categories:performance": [
              "error",
              {
                "minScore": 0.85
              }
            ],
            "categories:seo": "off",
            "is-crawlable": "off"
          }
        },
        {
          "matchingUrlPattern": "^(?!.*404\\.html$).*$",
          "preset": "lighthouse:no-pwa",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 350
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 200000
              }
            ],
            "resource-summary:image:size": [
              "error",
              {
                "maxNumericValue": 900000
              }
            ],
            "resource-summary:stylesheet:size": [
              "error",
              {
                "maxNumericValue": 60000
              }
            ],
            "uses-text-compression": "off",
            "uses-long-cache-ttl": "off",
            "server-response-time": "off",
            "csp-xss": "off",
            "third-party-cookies": "warn",
            "unused-javascript": "warn",
            "legacy-javascript": "warn",
            "lcp-lazy-loaded": "off",
            "prioritize-lcp-image": "off",
            "non-composited-animations": "off",
            "categories:performance": [
              "error",
              {
                "minScore": 0.85
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci/mobile"
    }
  }
}
